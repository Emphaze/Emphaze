{
  "name": "orbita-html",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/local.js",
    "build": "node scripts/prepare-public.mjs",
    "preview": "python3 scripts/serve.py --directory dist",
    "test": "node --test tests/*.test.js",
    "start": "node server/local.js",
    "deploy": "node scripts/prepare-public.mjs && wrangler d1 migrations apply ORBITA_DB --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply ORBITA_DB --local",
    "worker:dev": "node scripts/prepare-public.mjs && wrangler dev --ip 0.0.0.0 --port 8787"
  },
  "devDependencies": {
    "wrangler": "^4.150.0"
  },
  "engines": {
    "node": ">=24"
  }
}
